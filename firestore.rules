rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Dompet Omti: Personal Finance Cloud Collections
    match /transactions/{transactionId} {
      allow read, write: if isValidId(transactionId);
    }

    match /categories/{categoryId} {
      allow read, write: if isValidId(categoryId);
    }

    match /payment_methods/{paymentMethodId} {
      allow read, write: if isValidId(paymentMethodId);
    }

    match /budgets/{budgetId} {
      allow read, write: if isValidId(budgetId);
    }

    match /recurring_transactions/{recurringId} {
      allow read, write: if isValidId(recurringId);
    }

    match /user_profile/{profileId} {
      allow read, write: if isValidId(profileId);
    }

    match /test/{testId} {
      allow read, write: if isValidId(testId);
    }
  }
}
